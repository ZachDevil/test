<?xml version="1.0" encoding="UTF-8"?>
<!-- Polarion实例1配置文件 -->
<polarion-configuration>
    <!-- 基本配置 -->
    <instance>
        <name>polarion-instance-1</name>
        <id>instance1</id>
        <port>8080</port>
        <context-path>/polarion</context-path>
    </instance>
    
    <!-- 数据库配置 -->
    <database>
        <type>postgresql</type>
        <host>localhost</host>
        <port>5432</port>
        <name>polarion1_db</name>
        <user>polarion_user</user>
        <password>polarion_password</password>
        <pool>
            <min-size>5</min-size>
            <max-size>50</max-size>
            <timeout>30000</timeout>
        </pool>
    </database>
    
    <!-- SVN仓库配置 -->
    <svn>
        <repository-path>/data/svn/polarion1</repository-path>
        <url>file:///data/svn/polarion1</url>
        <cache>
            <enabled>true</enabled>
            <size>1024</size> <!-- MB -->
        </cache>
    </svn>
    
    <!-- Session配置 -->
    <session>
        <cookie-name>POLARION1_SESSIONID</cookie-name>
        <cookie-path>/polarion1</cookie-path>
        <cookie-domain>.company.com</cookie-domain>
        <timeout>1800</timeout> <!-- 30分钟 -->
        <secure-cookie>false</secure-cookie> <!-- 生产环境应设置为true -->
        <http-only>true</http-only>
    </session>
    
    <!-- SSO集成配置 -->
    <authentication>
        <type>custom-sso</type>
        <sso>
            <enabled>true</enabled>
            <service-url>http://localhost:8100/sso</service-url>
            <filter-class>com.company.polarion.sso.SSOAuthenticationFilter</filter-class>
            <exclude-patterns>
                <pattern>.*\.(js|css|png|jpg|gif|ico)$</pattern>
                <pattern>/polarion/api/public/.*</pattern>
                <pattern>/polarion/health</pattern>
            </exclude-patterns>
            <attributes-mapping>
                <username>preferred_username</username>
                <email>email</email>
                <roles>polarion_roles</roles>
            </attributes-mapping>
        </sso>
        <!-- 备用：LDAP配置 -->
        <ldap>
            <enabled>false</enabled>
            <url>ldap://ldap.company.com:389</url>
            <base-dn>ou=users,dc=company,dc=com</base-dn>
            <user-search-filter>(&amp;(objectClass=person)(uid={0}))</user-search-filter>
            <group-search-base>ou=groups,dc=company,dc=com</group-search-base>
            <group-search-filter>(&amp;(objectClass=groupOfUniqueNames)(uniqueMember={0}))</group-search-filter>
        </ldap>
    </authentication>
    
    <!-- 日志配置 -->
    <logging>
        <root-level>INFO</root-level>
        <file>/var/log/polarion/instance1/polarion.log</file>
        <max-file-size>100MB</max-file-size>
        <max-backup-index>10</max-backup-index>
        <pattern>%d{ISO8601} [%thread] %-5level %logger{36} - %msg%n</pattern>
        <loggers>
            <logger name="com.company.polarion.sso" level="DEBUG"/>
            <logger name="org.apache.http" level="WARN"/>
            <logger name="org.postgresql" level="WARN"/>
        </loggers>
    </logging>
    
    <!-- 缓存配置 -->
    <cache>
        <provider>ehcache</provider>
        <config-file>/opt/polarion1/etc/ehcache.xml</config-file>
        <distributed>
            <enabled>false</enabled>
            <multicast-group>230.0.0.1</multicast-group>
            <multicast-port>4446</multicast-port>
        </distributed>
    </cache>
    
    <!-- 性能优化配置 -->
    <performance>
        <thread-pool>
            <core-size>10</core-size>
            <max-size>100</max-size>
            <queue-capacity>1000</queue-capacity>
            <keep-alive-seconds>60</keep-alive-seconds>
        </thread-pool>
        <query>
            <max-results>1000</max-results>
            <timeout>60000</timeout> <!-- 毫秒 -->
            <cache-enabled>true</cache-enabled>
        </query>
        <indexing>
            <batch-size>100</batch-size>
            <commit-interval>5000</commit-interval> <!-- 毫秒 -->
            <optimize-interval>3600000</optimize-interval> <!-- 1小时 -->
        </indexing>
    </performance>
    
    <!-- 集成配置 -->
    <integrations>
        <!-- Jenkins集成 -->
        <jenkins>
            <enabled>true</enabled>
            <url>http://jenkins.company.com:8080</url>
            <api-token>jenkins-api-token</api-token>
        </jenkins>
        <!-- Git集成 -->
        <git>
            <enabled>true</enabled>
            <repositories>
                <repository>
                    <name>main</name>
                    <url>https://git.company.com/polarion-projects</url>
                </repository>
            </repositories>
        </git>
    </integrations>
    
    <!-- 通知配置 -->
    <notifications>
        <email>
            <enabled>true</enabled>
            <smtp>
                <host>smtp.company.com</host>
                <port>587</port>
                <username>polarion@company.com</username>
                <password>email-password</password>
                <use-tls>true</use-tls>
            </smtp>
            <from>polarion-instance1@company.com</from>
        </email>
    </notifications>
    
    <!-- 备份配置 -->
    <backup>
        <enabled>true</enabled>
        <schedule>0 2 * * *</schedule> <!-- 每天凌晨2点 -->
        <path>/backup/polarion1</path>
        <retention-days>30</retention-days>
        <include-database>true</include-database>
        <include-svn>true</include-svn>
        <include-attachments>true</include-attachments>
    </backup>
</polarion-configuration>